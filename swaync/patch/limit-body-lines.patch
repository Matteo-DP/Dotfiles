+        private const string BODY_LINE_SEP = "\u2028";
+
+        /** Cuts the text after the max number of lines and adds an ellipsis */
+        private string limit_body_lines (string text) {
+            if (this.number_of_body_lines <= 0) {
+                return text;
+            }
+            int pos = 0;
+            int count = 0;
+            while ((pos = text.index_of (BODY_LINE_SEP, pos)) >= 0) {
+                count++;
+                if (count >= this.number_of_body_lines) {
+                    return text.substring (0, pos).chomp () + "\u2026";
+                }
+                pos += BODY_LINE_SEP.length;
+            }
+            return text;
+        }
