// -*- mode: jsonc -*-
// Theme: default. Floating bar with a notification bell.
{
    "include": ["~/.config/waybar/modules.jsonc"],

    "margin-top": 4,
    "margin-left": 4,
    "margin-right": 4,
    "margin-bottom": 0,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "wlr/taskbar"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "battery", "tray", "custom/notification"]
}
