# Ignore everything in ~/.config by default
/*

# ...except these tracked configs
!/.gitignore
!/.gitmodules
!/README.md
!/AGENTS.md
!/hypr/
!/wofi/
!/mako/
!/swaync/
!/ags/
!/waybar/
!/kitty/
!/btop/
!/cava/
!/nwg-look/
!/xsettingsd/
!/zed/
!/xournalpp/
!/mimeapps.list
!/batsignal
!/nvim

# ignore the current theme symlinks
hypr/colors/current-theme/

# Only specific files from these folders
!/gtk-3.0/
/gtk-3.0/*
!/gtk-3.0/settings.ini
!/gtk-4.0/
/gtk-4.0/*
!/gtk-4.0/settings.ini
!/htop/
/htop/*
!/htop/htoprc
!/systemd/
/systemd/*
!/systemd/user/
/systemd/user/*
!/systemd/user/monitor-hook.service
!/systemd/user/ivm-watch.service
!/systemd/user/ivm-watch.service.d/
!/systemd/user/app-dev.lizardbyte.app.Sunshine.service.d/

# iPad second screen (Sunshine + ivm). Not credentials, state (password hash), logs or backups.
!/sunshine/
/sunshine/*
!/sunshine/sunshine.conf
!/sunshine/apps.json
!/ivm/
